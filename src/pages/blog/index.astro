---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title="Blog" description="Writing on Vue.js, productivity and personal growth.">
  <header class="mb-12">
    <h1 class="text-2xl text-term-bright tracking-tight mb-3">Writing</h1>
    <p class="max-w-prose text-term-dim">
      Thoughts on development, productivity and personal growth.
    </p>
  </header>

  <ul class="space-y-10">
    {
      posts.map((post) => (
        <li>
          <time
            class="block text-xs text-term-dim mb-1"
            datetime={post.data.date.toISOString()}
          >
            {fmt(post.data.date)}
          </time>
          <h2 class="text-lg tracking-tight mb-2">
            <a class="link" href={`/blog/${post.id}/`}>
              {post.data.title}
            </a>
          </h2>
          <p class="text-sm text-term-dim max-w-prose line-clamp-3">
            {post.data.summary}
          </p>
        </li>
      ))
    }
  </ul>
</Base>
