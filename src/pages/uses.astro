---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';

const stack = [
  {
    heading: 'frontend',
    items: [
      { name: 'Astro', url: 'https://astro.build', note: 'static sites and content' },
      { name: 'Vue 3', url: 'https://vuejs.org', note: 'app framework of choice' },
      { name: 'TypeScript', url: 'https://www.typescriptlang.org', note: 'everywhere it fits' },
      { name: 'Tailwind CSS', url: 'https://tailwindcss.com', note: 'styling' },
    ],
  },
  {
    heading: 'backend',
    items: [
      { name: 'Cloudflare Workers', url: 'https://workers.cloudflare.com', note: 'APIs and form handling at the edge' },
      { name: 'AdonisJS', url: 'https://adonisjs.com', note: 'full-featured Node backends' },
      { name: 'Rust', url: 'https://www.rust-lang.org', note: 'native and terminal tooling' },
    ],
  },
  {
    heading: 'hosting',
    items: [
      { name: 'Cloudflare', url: 'https://cloudflare.com', note: 'most projects' },
      { name: 'Netlify', url: 'https://netlify.com', note: 'vcalendar.io and this site' },
    ],
  },
];
---

<Base title="Uses" description="The tools and technologies Nathan Reyes builds with.">
  <header class="mb-12">
    <h1 class="text-2xl text-term-bright tracking-tight mb-3">Uses</h1>
    <p class="max-w-prose text-term-dim">
      What I reach for when starting something new.
    </p>
  </header>

  <div class="space-y-10">
    {
      stack.map((group) => (
        <section>
          <SectionHeading class="capitalize">{group.heading}</SectionHeading>
          <ul class="space-y-2">
            {group.items.map((item) => (
              <li class="flex flex-wrap items-baseline gap-x-3">
                <a class="link" href={item.url}>
                  {item.name}
                </a>
                <span class="text-sm text-term-dim">{item.note}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
