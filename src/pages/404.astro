---
import Base from '../layouts/Base.astro';
import Prompt from '../components/Prompt.astro';
---

<Base title="404" description="Page not found.">
  <Prompt cmd="cd ./missing-page" class="mb-5" />
  <h1 class="text-2xl text-term-bright tracking-tight mb-3">Page not found</h1>
  <p class="max-w-prose text-term-dim mb-8">
    That page doesn't exist. It may have moved, or the link may be out of date.
  </p>
  <a class="link" href="/">&larr; Back home</a>
</Base>
